rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // User Rules
    function isValidUser(data, isCreate) {
      // For create: exact keys
      let validKeys = isCreate ? data.keys().hasAll(['interests', 'createdAt', 'updatedAt']) && data.keys().size() == 3 : true;
      
      let validInterests = data.interests is list && data.interests.size() <= 50;
      let validTimestamps = data.createdAt is timestamp && data.updatedAt is timestamp;
      
      return validKeys && validInterests && validTimestamps;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      // No list needed
      allow list: if false;

      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUser(incoming(), true)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidUser(incoming(), false)
        && incoming().diff(existing()).affectedKeys().hasOnly(['interests', 'updatedAt'])
        && incoming().updatedAt == request.time;
      
      allow delete: if false;
    }

  }
}
